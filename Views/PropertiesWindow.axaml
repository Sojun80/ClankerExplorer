<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClankerExplorer.ViewModels"
        xmlns:controls="clr-namespace:ClankerExplorer.Controls"
        x:Class="ClankerExplorer.Views.PropertiesWindow"
        x:DataType="vm:PropertiesViewModel"
        Title="Item Properties"
        Width="500" Height="620"
        MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{DynamicResource AppUiFont}"
        CanResize="True">

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <!-- 1. Header Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
        <!-- Icon -->
        <Image Grid.Column="0" Grid.RowSpan="2"
               Source="{Binding Icon}"
               Width="42" Height="42"
               Margin="0,0,12,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <!-- Item Name (Selectable) -->
        <TextBox Grid.Column="1" Grid.Row="0"
                 Text="{Binding ItemName}"
                 IsReadOnly="True"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 FontSize="14"
                 FontWeight="Bold"
                 Foreground="{DynamicResource AppTextBrush}"
                 VerticalAlignment="Center">
          <TextBox.Styles>
            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
            </Style>
          </TextBox.Styles>
        </TextBox>

        <!-- Type & Size Badges -->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Border Background="{DynamicResource AppBgBrush}"
                  BorderBrush="{DynamicResource AppHighlightBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,2">
            <TextBlock Text="{Binding ItemTypeDisplay}" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppHighlightBrush}"/>
          </Border>

          <Border Background="{DynamicResource AppBgBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,2">
            <TextBlock Text="{Binding SizeDisplay}" FontSize="10.5"
                       FontFamily="{DynamicResource AppMonoFont}"
                       Foreground="{DynamicResource AppSubTextBrush}"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. Scrollable Body: Metadata Sections & Checksums -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <!-- Loading Indicator -->
        <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" Margin="0,20" Spacing="8">
          <ProgressBar IsIndeterminate="True" Width="140" Height="4" Foreground="{DynamicResource AppHighlightBrush}"/>
          <TextBlock Text="Extracting item metadata..." FontSize="11" Foreground="{DynamicResource AppSubTextBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error Banner -->
        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="#EF4444"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- Reusable Metadata View -->
        <controls:MetadataView Sections="{Binding Metadata.Sections}"
                               IsVisible="{Binding Metadata, Converter={x:Static ObjectConverters.IsNotNull}}"/>

        <!-- Checksums Section (Files only) -->
        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                IsVisible="{Binding !IsDirectory}">
          <StackPanel Spacing="6">
            <DockPanel LastChildFill="True">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Checksums" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppHighlightBrush}" VerticalAlignment="Center"/>
              </StackPanel>

              <Button DockPanel.Dock="Right"
                      Command="{Binding ComputeHashesCommand}"
                      IsEnabled="{Binding !IsHashing}"
                      Content="Calculate Hashes"
                      Classes="power-btn"
                      FontSize="11"
                      Padding="8,3"
                      HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Hashing Progress -->
            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsHashing}"
                         Foreground="{DynamicResource AppHighlightBrush}" Margin="0,2"/>

            <!-- Calculated Hashes -->
            <StackPanel Spacing="4" IsVisible="{Binding HasHashes}">
              <Grid ColumnDefinitions="110,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="SHA-256" Foreground="{DynamicResource AppSubTextBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Sha256}" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         FontFamily="{DynamicResource AppMonoFont}" FontSize="10"
                         Foreground="{DynamicResource AppHighlightBrush}">
                  <TextBox.Styles>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                  </TextBox.Styles>
                </TextBox>
              </Grid>

              <Grid ColumnDefinitions="110,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="MD5" Foreground="{DynamicResource AppSubTextBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Md5}" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         FontFamily="{DynamicResource AppMonoFont}" FontSize="10"
                         Foreground="{DynamicResource AppTextBrush}">
                  <TextBox.Styles>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                  </TextBox.Styles>
                </TextBox>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 3. Footer Bar -->
    <DockPanel Grid.Row="2" LastChildFill="False">
      <Button Content="Close"
              Click="OnCloseClicked"
              Classes="power-btn"
              DockPanel.Dock="Right"
              Padding="20,5"
              FontSize="12"/>
    </DockPanel>
  </Grid>
</Window>
