<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClankerExplorer.ViewModels"
             xmlns:views="clr-namespace:ClankerExplorer.Views"
             xmlns:models="clr-namespace:ClankerExplorer.Models"
             xmlns:preview="clr-namespace:ClankerExplorer.Services.Preview"
             x:Class="ClankerExplorer.Views.InspectorPanelView"
             x:DataType="vm:InspectorViewModel"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="600"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

  <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- Header -->
      <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
              Height="36" Padding="10,0">
        <DockPanel LastChildFill="True">
          <!-- Title on Left -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="🔍" FontSize="12"/>
            <TextBlock Text="Preview Window" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
          </StackPanel>

          <!-- Image Zoom Toolbar on Right (Visible when viewing an image) -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                      IsVisible="{Binding IsImagePreview}">
            <Button Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out (Ctrl+Wheel Down)"
                    Classes="power-btn" Padding="5,2" FontSize="10" MinWidth="22">
              <TextBlock Text="−" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Button>
            <Button Command="{Binding ResetZoomCommand}" ToolTip.Tip="Fit to Pane (Reset Zoom)"
                    Classes="power-btn" Padding="6,2" FontSize="10">
              <TextBlock Text="{Binding ZoomPercentDisplay}" FontSize="9.5" FontWeight="SemiBold"
                         FontFamily="{DynamicResource AppMonoFont}" Foreground="{DynamicResource AppHighlightBrush}"/>
            </Button>
            <Button Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In (Ctrl+Wheel Up)"
                    Classes="power-btn" Padding="5,2" FontSize="10" MinWidth="22">
              <TextBlock Text="+" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Button>
            <Button Command="{Binding ActualSizeCommand}" ToolTip.Tip="Actual Size (100% / 1:1)"
                    Classes="power-btn" Padding="5,2" FontSize="9.5" MinWidth="24">
              <TextBlock Text="1:1" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Button>
          </StackPanel>

          <!-- PDF Navigation Toolbar on Right (Visible when viewing a PDF) -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      IsVisible="{Binding IsPdfPreview}">
            <Button Command="{Binding PrevPdfPageCommand}" IsEnabled="{Binding CanPdfGoPrev}"
                    ToolTip.Tip="Previous Page" Classes="power-btn" Padding="5,2" FontSize="10">
              <TextBlock Text="◀" FontSize="9" HorizontalAlignment="Center"/>
            </Button>
            <TextBlock Text="{Binding PdfPageDisplay}" FontSize="10" FontWeight="SemiBold"
                       FontFamily="{DynamicResource AppMonoFont}" Foreground="{DynamicResource AppHighlightBrush}"
                       VerticalAlignment="Center" Margin="2,0"/>
            <Button Command="{Binding NextPdfPageCommand}" IsEnabled="{Binding CanPdfGoNext}"
                    ToolTip.Tip="Next Page" Classes="power-btn" Padding="5,2" FontSize="10">
              <TextBlock Text="▶" FontSize="9" HorizontalAlignment="Center"/>
            </Button>
            <Button Command="{Binding TogglePdfFitWidthCommand}"
                    ToolTip.Tip="Toggle Fit Page / Fit Width" Classes="power-btn" Padding="5,2" FontSize="9.5">
              <TextBlock Text="↔" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Button>
          </StackPanel>

          <!-- ZIP Summary on Right (Visible when viewing a ZIP) -->
          <TextBlock DockPanel.Dock="Right" Text="{Binding ZipSummaryDisplay}" FontSize="10"
                     FontFamily="{DynamicResource AppMonoFont}" Foreground="{DynamicResource AppHighlightBrush}"
                     VerticalAlignment="Center" IsVisible="{Binding IsZipPreview}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

      <!-- Content Area -->
      <Grid Grid.Row="1" Margin="8">
        <!-- Empty State -->
        <TextBlock Text="Select a file to inspect preview, code, hex, or hashes"
                   IsVisible="{Binding PreviewData, Converter={x:Static ObjectConverters.IsNull}}"
                   Foreground="{DynamicResource AppSubTextBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>

        <!-- Populated Inspector Content -->
        <Grid RowDefinitions="*,Auto" IsVisible="{Binding PreviewData, Converter={x:Static ObjectConverters.IsNotNull}}">

          <!-- 1. IMAGE PREVIEW -->
          <Border Grid.Row="0" Background="#0C1017" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True"
                  IsVisible="{Binding IsImagePreview}"
                  PointerWheelChanged="OnImagePointerWheelChanged"
                  DoubleTapped="OnImageDoubleTapped">
            <Panel>
              <!-- Subtle backdrop -->
              <Border Background="{DynamicResource AppBgBrush}" Opacity="0.3"/>

              <!-- Fit Mode -->
              <Image Source="{Binding ImagePreview}"
                     IsVisible="{Binding IsFitMode}"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="HighQuality"/>

              <!-- Zoomed/Pan Mode -->
              <ScrollViewer IsVisible="{Binding !IsFitMode}"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <LayoutTransformControl>
                    <LayoutTransformControl.LayoutTransform>
                      <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                    </LayoutTransformControl.LayoutTransform>
                    <Image Source="{Binding ImagePreview}"
                           Stretch="None"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  </LayoutTransformControl>
                </Panel>
              </ScrollViewer>

              <!-- Dimension & Zoom Badge -->
              <Border Background="#DD0D1520" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="6,2" Margin="8"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding ImageDimensions}" FontSize="10"
                             Foreground="{DynamicResource AppTextBrush}" FontFamily="{DynamicResource AppMonoFont}"/>
                  <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource AppSubTextBrush}"/>
                  <TextBlock Text="{Binding ZoomPercentDisplay}" FontSize="10"
                             Foreground="{DynamicResource AppHighlightBrush}" FontFamily="{DynamicResource AppMonoFont}" FontWeight="Bold"/>
                </StackPanel>
              </Border>
            </Panel>
          </Border>

          <!-- 2. VIDEO PREVIEW -->
          <Border Grid.Row="0" Background="#080C12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True"
                  IsVisible="{Binding IsVideoPreview}">
            <Grid RowDefinitions="*,Auto">
              <!-- Video Viewport -->
              <Panel Grid.Row="0">
                <!-- Native Video Control Host (renders when playing) -->
                <views:NativeVideoHost x:Name="VideoHost"
                                       IsVisible="{Binding IsVideoPlaying}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Poster Frame / Static Thumbnail (renders when stopped or paused) -->
                <Panel IsVisible="{Binding !IsVideoPlaying}">
                  <Image Source="{Binding VideoPosterImage}"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderOptions.BitmapInterpolationMode="HighQuality"/>

                  <!-- Big Central Play Button -->
                  <Button Command="{Binding TogglePlayPauseCommand}"
                          Classes="power-btn"
                          Width="56" Height="56" CornerRadius="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Padding="0" Background="#99000000" BorderBrush="{DynamicResource AppHighlightBrush}" BorderThickness="2"
                          ToolTip.Tip="Play Video">
                    <TextBlock Text="▶" FontSize="22" Foreground="{DynamicResource AppHighlightBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                  </Button>
                </Panel>
              </Panel>

              <!-- Video Media Controls Toolbar -->
              <Border Grid.Row="1" Background="#E60D1520" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                  <!-- Play / Pause Button -->
                  <Button Grid.Column="0" Command="{Binding TogglePlayPauseCommand}"
                          Classes="power-btn" Padding="6,3" FontSize="11" Margin="0,0,6,0">
                    <TextBlock Text="{Binding PlayPauseButtonIcon}" FontWeight="Bold"/>
                  </Button>

                  <!-- Current Time -->
                  <TextBlock Grid.Column="1" Text="{Binding FormattedVideoPosition}" FontSize="10"
                             FontFamily="{DynamicResource AppMonoFont}" Foreground="{DynamicResource AppTextBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>

                  <!-- Seek Slider -->
                  <Slider Grid.Column="2" Minimum="0" Maximum="{Binding VideoDurationSeconds}" Value="{Binding VideoPositionSeconds, Mode=OneWay}"
                          PointerCaptureLost="OnVideoSliderPointerCaptureLost"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>

                  <!-- Total Duration -->
                  <TextBlock Grid.Column="3" Text="{Binding FormattedVideoDuration}" FontSize="10"
                             FontFamily="{DynamicResource AppMonoFont}" Foreground="{DynamicResource AppSubTextBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>

                  <!-- Mute Button -->
                  <Button Grid.Column="4" Command="{Binding ToggleMuteCommand}"
                          Classes="power-btn" Padding="5,3" FontSize="11" Margin="0,0,4,0" ToolTip.Tip="Toggle Mute">
                    <TextBlock Text="{Binding MuteButtonIcon}"/>
                  </Button>

                  <!-- Volume Slider -->
                  <Slider Grid.Column="5" Minimum="0" Maximum="1" Width="55" Value="{Binding VideoVolume}"
                          VerticalAlignment="Center" ToolTip.Tip="Volume"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- 3. PDF PREVIEW -->
          <Border Grid.Row="0" Background="#0C1017" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True"
                  IsVisible="{Binding IsPdfPreview}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Panel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8">
                <Image Source="{Binding PdfCurrentPageBitmap}"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
              </Panel>
            </ScrollViewer>
          </Border>

          <!-- 4. ZIP ARCHIVE PREVIEW -->
          <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True"
                  IsVisible="{Binding IsZipPreview}">
            <DataGrid ItemsSource="{Binding ZipEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      BorderThickness="0"
                      Background="Transparent"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="preview:ZipEntryItem">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                        <TextBlock Text="{Binding IndentPadding}"/>
                        <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontWeight="{Binding IsDirectory, Converter={x:Static ObjectConverters.IsNull}, FallbackValue='Normal'}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="75"
                                    FontFamily="{DynamicResource AppMonoFont}"/>
                <DataGridTextColumn Header="Ratio" Binding="{Binding CompressionRatio}" Width="55"
                                    FontFamily="{DynamicResource AppMonoFont}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <!-- 5. TEXT PREVIEW -->
          <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="6" Margin="0,0,0,8"
                  IsVisible="{Binding IsTextPreview}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <TextBox Text="{Binding PreviewData.TextContent}" IsReadOnly="True"
                       Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource AppTextBrush}" FontFamily="{DynamicResource AppMonoFont}" FontSize="11"/>
            </ScrollViewer>
          </Border>

          <!-- 6. HEX DUMP PREVIEW -->
          <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="6" Margin="0,0,0,8"
                  IsVisible="{Binding IsBinaryPreview}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding HexRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:HexRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Offset}" Foreground="{DynamicResource AppSubTextBrush}"
                                 FontFamily="{DynamicResource AppMonoFont}" FontSize="10.5" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding HexBytes}" Foreground="{DynamicResource AppHighlightBrush}"
                                 FontFamily="{DynamicResource AppMonoFont}" FontSize="10.5" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding AsciiText}" Foreground="{DynamicResource AppTextBrush}"
                                 FontFamily="{DynamicResource AppMonoFont}" FontSize="10.5"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- Loading State -->
          <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12" Margin="0,0,0,8"
                  IsVisible="{Binding IsLoadingPreview}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
              <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="{DynamicResource AppHighlightBrush}"/>
              <TextBlock Text="Loading preview..." FontSize="11" Foreground="{DynamicResource AppSubTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Error State -->
          <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12" Margin="0,0,0,8"
                  IsVisible="{Binding PreviewErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center"/>
              <TextBlock Text="Preview unavailable" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding PreviewErrorMessage}" FontSize="10" Foreground="{DynamicResource AppSubTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Metadata Summary Card -->
          <Border Grid.Row="1" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="8,6">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Name:" Foreground="{DynamicResource AppSubTextBrush}" FontSize="10.5" Width="55"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewData.Name}" Foreground="{DynamicResource AppTextBrush}"
                           FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Size:" Foreground="{DynamicResource AppSubTextBrush}" FontSize="10.5" Width="55"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewData.FormattedSize}" Foreground="{DynamicResource AppHighlightBrush}"
                           FontSize="10.5" FontFamily="{DynamicResource AppMonoFont}"/>
              </Grid>
              <!-- Dimensions (Visible for image files) -->
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ImageDimensions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Grid.Column="0" Text="Dims:" Foreground="{DynamicResource AppSubTextBrush}" FontSize="10.5" Width="55"/>
                <TextBlock Grid.Column="1" Text="{Binding ImageDimensions}" Foreground="{DynamicResource AppHighlightBrush}"
                           FontSize="10.5" FontFamily="{DynamicResource AppMonoFont}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="Modified:" Foreground="{DynamicResource AppSubTextBrush}" FontSize="10.5" Width="55"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewData.ModifiedTime}" Foreground="{DynamicResource AppTextBrush}"
                           FontSize="10.5" FontFamily="{DynamicResource AppMonoFont}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Footer: Checksums Calculator -->
      <Border Grid.Row="2" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
        <StackPanel Spacing="4">
          <DockPanel>
            <TextBlock Text="File Checksums" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
            <Button Command="{Binding ComputeHashesCommand}" Content="Compute Hashes"
                    Classes="power-btn" FontSize="10" Padding="6,2" HorizontalAlignment="Right"/>
          </DockPanel>

          <!-- Checksum Values (Visible when computed) -->
          <StackPanel Spacing="3" IsVisible="{Binding HasHashes}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="SHA-256:" Foreground="{DynamicResource AppSubTextBrush}" FontSize="10" Width="55"/>
              <TextBox Grid.Column="1" Text="{Binding Sha256Hash}" IsReadOnly="True"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       FontFamily="{DynamicResource AppMonoFont}" FontSize="9.5" Foreground="{DynamicResource AppHighlightBrush}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="MD5:" Foreground="{DynamicResource AppSubTextBrush}" FontSize="10" Width="55"/>
              <TextBox Grid.Column="1" Text="{Binding Md5Hash}" IsReadOnly="True"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       FontFamily="{DynamicResource AppMonoFont}" FontSize="9.5" Foreground="{DynamicResource AppTextBrush}"/>
            </Grid>
          </StackPanel>

          <!-- Computing State -->
          <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsHashing}" Foreground="{DynamicResource AppHighlightBrush}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
