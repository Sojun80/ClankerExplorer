<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClankerExplorer.ViewModels"
             xmlns:models="clr-namespace:ClankerExplorer.Models"
             x:Class="ClankerExplorer.Views.ExplorerPaneView"
             x:DataType="vm:ExplorerPaneViewModel"
             PointerPressed="OnPanePointerPressed"
             PointerReleased="OnPanePointerReleased"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600">

  <UserControl.Styles>
    <Style Selector="Border.tab-border">
      <Setter Property="Background" Value="{DynamicResource AppBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1,1,1,0"/>
      <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Border.tab-border:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Opacity" Value="1.0"/>
    </Style>
    <Style Selector="Border.tab-border.active">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppHighlightBrush}"/>
      <Setter Property="BorderThickness" Value="1,1,1,0"/>
      <Setter Property="Opacity" Value="1.0"/>
    </Style>
    <Style Selector="Border.tab-border.dragging">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Row 0: Tab Bar -->
    <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Height="36">
      <DockPanel>
        <!-- Pane Label (if dual pane) -->
        <Border DockPanel.Dock="Left" IsVisible="{Binding PaneLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="3"
                Padding="6,2" Margin="6,4,4,4" VerticalAlignment="Center">
          <TextBlock Text="{Binding PaneLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppHighlightBrush}" FontFamily="{DynamicResource AppMonoFont}"/>
        </Border>

        <!-- Right controls: Notepad++ Style Scroll Arrows (Only visible when tabs overflow!) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="2,0,6,0">
          <StackPanel x:Name="TabScrollButtonsPanel" Orientation="Horizontal" Spacing="2" IsVisible="False">
            <!-- Scroll Left Arrow Button -->
            <Button x:Name="TabScrollLeftBtn" Click="OnTabScrollLeftClicked"
                    Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="3,0,0,3" Padding="5,2" Height="22" Width="20"
                    ToolTip.Tip="Scroll Tabs Left" VerticalAlignment="Center">
              <TextBlock Text="◀" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSubTextBrush}"/>
            </Button>
            <!-- Scroll Right Arrow Button -->
            <Button x:Name="TabScrollRightBtn" Click="OnTabScrollRightClicked"
                    Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,1,1"
                    CornerRadius="0,3,3,0" Padding="5,2" Height="22" Width="20"
                    ToolTip.Tip="Scroll Tabs Right" VerticalAlignment="Center">
              <TextBlock Text="▶" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSubTextBrush}"/>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Tabs List (Hidden Scrollbar + Mouse Wheel Support + '+' directly next to rightmost tab) -->
        <ScrollViewer x:Name="TabsScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PointerWheelChanged="OnTabsPointerWheelChanged">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ExplorerTabViewModel">
                <Grid Margin="2,4,0,0">
                  <!-- Left Drop Insertion Indicator Line -->
                  <Border Width="3" Background="{DynamicResource AppHighlightBrush}" Margin="-2,-1,0,-1"
                          HorizontalAlignment="Left" CornerRadius="1.5" ZIndex="20"
                          IsVisible="{Binding IsDropTargetLeft}"/>

                  <!-- Right Drop Insertion Indicator Line -->
                  <Border Width="3" Background="{DynamicResource AppHighlightBrush}" Margin="0,-1,-2,-1"
                          HorizontalAlignment="Right" CornerRadius="1.5" ZIndex="20"
                          IsVisible="{Binding IsDropTargetRight}"/>

                  <!-- Tab Container with Configurable Width & Clean Layout -->
                  <Border Classes="tab-border" Classes.active="{Binding IsSelected}" Classes.dragging="{Binding IsBeingDragged}"
                          CornerRadius="4,4,0,0" Padding="8,5" Cursor="Hand"
                          Width="{Binding $parent[UserControl].((vm:ExplorerPaneViewModel)DataContext).TabWidth}"
                          PointerPressed="OnTabPointerPressed"
                          PointerMoved="OnTabPointerMoved"
                          PointerReleased="OnTabPointerReleased"
                          PointerCaptureLost="OnTabPointerCaptureLost">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Command="{Binding $parent[UserControl].((vm:ExplorerPaneViewModel)DataContext).TogglePinTabCommand}"
                                  CommandParameter="{Binding}">
                          <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="📌"/>
                              <TextBlock Text="Pin / Unpin Tab"/>
                            </StackPanel>
                          </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="Duplicate Tab"
                                  Command="{Binding $parent[UserControl].((vm:ExplorerPaneViewModel)DataContext).DuplicateTabCommand}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Close Other Tabs"
                                  Command="{Binding $parent[UserControl].((vm:ExplorerPaneViewModel)DataContext).CloseOtherTabsCommand}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Close Tab"
                                  Command="{Binding $parent[UserControl].((vm:ExplorerPaneViewModel)DataContext).CloseTabCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding !IsPinned}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                      <TextBlock DockPanel.Dock="Left" Text="📌" FontSize="11" Margin="0,0,4,0" IsVisible="{Binding IsPinned}" ToolTip.Tip="Pinned Tab (Always Restored)" VerticalAlignment="Center"/>
                      <Path DockPanel.Dock="Left" Data="M 2 4 C 2 2.9 2.9 2 4 2 L 7.5 2 C 8.3 2 9.1 2.5 9.5 3.2 L 10.5 4.8 C 10.8 5.2 11.2 5.5 11.7 5.5 L 18 5.5 C 19.1 5.5 20 6.4 20 7.5 L 20 15 C 20 16.1 19.1 17 18 17 L 4 17 C 2.9 17 2 16.1 2 15 Z"
                            Fill="{DynamicResource AppAccentBrush}" Stroke="{DynamicResource AppHighlightBrush}" StrokeThickness="0.6" Width="13" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"
                            IsVisible="{Binding !IsPinned}"/>
                      <Button DockPanel.Dock="Right" Command="{Binding $parent[UserControl].((vm:ExplorerPaneViewModel)DataContext).CloseTabCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding !IsPinned}"
                              Background="Transparent" BorderThickness="0" Padding="2,0" Margin="2,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource AppSubTextBrush}"/>
                      </Button>
                      <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource AppTextBrush}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0"/>
                    </DockPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- '+' New Tab Button directly next to rightmost tab -->
          <Button Command="{Binding AddNewTabCommand}"
                  Background="Transparent" BorderThickness="0" Padding="5,2" Margin="2,4,4,0" Height="26" Width="26"
                  CornerRadius="4"
                  ToolTip.Tip="New Tab (Ctrl+T)" VerticalAlignment="Center">
            <TextBlock Text="+" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppSubTextBrush}"/>
          </Button>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Row 1: Address Bar & Quick Actions -->
    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Navigation Buttons -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0">
          <Button Command="{Binding GoBackCommand}" IsEnabled="{Binding SelectedTab.CanGoBack, FallbackValue=False}"
                  Classes="power-btn" Padding="6,4" ToolTip.Tip="Back (Alt+Left / Mouse Back)">
            <TextBlock Text="←" FontWeight="Bold"/>
          </Button>
          <Button Command="{Binding GoForwardCommand}" IsEnabled="{Binding SelectedTab.CanGoForward, FallbackValue=False}"
                  Classes="power-btn" Padding="6,4" ToolTip.Tip="Forward (Alt+Right / Mouse Forward)">
            <TextBlock Text="→" FontWeight="Bold"/>
          </Button>
          <Button Command="{Binding GoUpCommand}"
                  Classes="power-btn" Padding="6,4" ToolTip.Tip="Up (Alt+Up)">
            <TextBlock Text="↑" FontWeight="Bold"/>
          </Button>
          <Button Command="{Binding RefreshCommand}"
                  Classes="power-btn" Padding="6,4" ToolTip.Tip="Refresh (F5)">
            <TextBlock Text="⟳" FontWeight="Bold"/>
          </Button>
        </StackPanel>

        <!-- Always Visible Directory Path TextBox with KeyDown Submit -->
        <TextBox Grid.Column="1" Text="{Binding RawAddressInput, Mode=TwoWay}"
                 KeyDown="OnAddressKeyDown"
                 Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                 FontFamily="{DynamicResource AppMonoFont}" FontSize="12"
                 Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0"/>

        <!-- 1-Click Copy Path Button -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
          <Button Click="OnCopyPathClicked"
                  Classes="power-btn" FontWeight="SemiBold"
                  ToolTip.Tip="Copy Full Path to Clipboard (Ctrl+Shift+C)">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="📋" FontSize="11"/>
              <TextBlock Text="Copy Path" FontFamily="{DynamicResource AppMonoFont}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- New Items Quick Creation -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
          <Button Command="{Binding TriggerNewFolderCommand}"
                  Classes="power-btn" ToolTip.Tip="New Folder (Ctrl+Shift+N)">
            <TextBlock Text="+ Folder"/>
          </Button>
          <Button Command="{Binding TriggerNewFileCommand}"
                  Classes="power-btn" ToolTip.Tip="New File (Ctrl+N)">
            <TextBlock Text="+ File"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Row 2: File Grid with Dual 14px Background Gutters (Left & Right) and Selection Marquee Overlay -->
    <Grid x:Name="FileGridContainer" Grid.Row="2" Background="{DynamicResource AppBgBrush}"
          PointerPressed="OnFileGridPointerPressed"
          PointerMoved="OnFileGridPointerMoved"
          PointerReleased="OnFileGridPointerReleased"
          PointerCaptureLost="OnFileGridPointerCaptureLost">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
      </Grid.ColumnDefinitions>

      <!-- 14px Dedicated Left Folder Background Gutter -->
      <Border Grid.Column="0" Background="{DynamicResource AppBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0"
              PointerPressed="OnFolderBackgroundStripPointerPressed"
              ToolTip.Tip="Folder Background Margin (Right-click for Folder Actions)">
        <Border.ContextMenu>
          <ContextMenu Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}"
                       BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <MenuItem Header="📁 New Folder" Command="{Binding TriggerNewFolderCommand}"/>
            <MenuItem Header="📄 New Text File" Command="{Binding TriggerNewFileCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="📋 Paste" Command="{Binding PasteFilesCommand}" IsEnabled="{Binding CanPaste}"/>
            <MenuItem Header=">_ Open PowerShell Here" Command="{Binding OpenTerminalCommand}"/>
            <MenuItem Header="🛡️ Open PowerShell as Administrator" Command="{Binding OpenTerminalAdminCommand}"/>
            <MenuItem Header="Open Command Prompt (CMD) Here" Command="{Binding OpenCmdCommand}"/>
            <MenuItem Header="🛡️ Open Command Prompt as Administrator" Command="{Binding OpenCmdAdminCommand}"/>
            <MenuItem Header="Open in VS Code" Command="{Binding OpenVSCodeCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="⟳ Refresh" Command="{Binding RefreshCommand}"/>
            <MenuItem Header="📋 Copy Current Path" Command="{Binding CopyCurrentPathCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="ℹ️ Folder Properties" Command="{Binding TriggerPropertiesCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <Border.Styles>
          <Style Selector="Border:hover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
          </Style>
        </Border.Styles>
      </Border>

      <!-- Main File DataGrid -->
      <DataGrid x:Name="FileDataGrid" Grid.Column="1"
                ItemsSource="{Binding SelectedTab.FilteredItems}"
                SelectedItem="{Binding SelectedTab.SelectedItem, Mode=TwoWay}"
                SelectionMode="Extended"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                CanUserReorderColumns="True"
                DoubleTapped="OnRowDoubleTapped"
                SelectionChanged="OnSelectionChanged"
                FontFamily="{DynamicResource AppUiFont}">
      <DataGrid.ContextMenu>
        <ContextMenu x:Name="GridContextMenu"
                     Background="{DynamicResource AppSurfaceBrush}"
                     Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     BorderThickness="1">

          <!-- ==================== 1. NORMAL FILES ==================== -->
          <MenuItem Header="Open" Command="{Binding OpenItemCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="{Binding EditActionLabel}" Command="{Binding EditItemCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Open With..." Command="{Binding OpenWithCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Copy" Command="{Binding CopyFilesCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Cut" Command="{Binding CutFilesCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Rename" Command="{Binding TriggerRenameCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="{Binding AddArchiveDialogLabel}" Command="{Binding AddToArchiveDialogCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="{Binding AddZipLabel}" Command="{Binding AddToZipCommand}" IsVisible="{Binding IsNormalFileSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsNormalFileSelected}"/>
          <MenuItem Header="Properties" Command="{Binding TriggerPropertiesCommand}" IsVisible="{Binding IsNormalFileSelected}"/>

          <!-- ==================== 2. ARCHIVE FILES ==================== -->
          <MenuItem Header="{Binding OpenArchiveLabel}" Command="{Binding OpenArchiveCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="{Binding ExtractHereLabel}" Command="{Binding ExtractHereCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="{Binding ExtractSubfolderLabel}" Command="{Binding ExtractToSubfolderCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="{Binding ExtractToLabel}" Command="{Binding ExtractToCustomCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="Copy" Command="{Binding CopyFilesCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="Cut" Command="{Binding CutFilesCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="Rename" Command="{Binding TriggerRenameCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding IsArchiveSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsArchiveSelected}"/>
          <MenuItem Header="Properties" Command="{Binding TriggerPropertiesCommand}" IsVisible="{Binding IsArchiveSelected}"/>

          <!-- ==================== 3. FOLDERS ==================== -->
          <MenuItem Header="Open" Command="{Binding OpenItemCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Open in New Tab" Command="{Binding OpenFolderInNewTabCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Open in Other Pane" Command="{Binding OpenFolderInOtherPaneCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="{Binding PinFolderLabel}" Command="{Binding PinFolderCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Copy" Command="{Binding CopyFilesCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Cut" Command="{Binding CutFilesCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Paste" Command="{Binding PasteFilesCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Rename" Command="{Binding TriggerRenameCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Open PowerShell Here" Command="{Binding OpenTerminalCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="🛡️ Open PowerShell as Administrator" Command="{Binding OpenTerminalAdminCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Open Command Prompt (CMD) Here" Command="{Binding OpenCmdCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="🛡️ Open Command Prompt as Administrator" Command="{Binding OpenCmdAdminCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Open in VS Code" Command="{Binding OpenVSCodeCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="{Binding AddArchiveDialogLabel}" Command="{Binding AddToArchiveDialogCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="{Binding AddZipLabel}" Command="{Binding AddToZipCommand}" IsVisible="{Binding IsFolderSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsFolderSelected}"/>
          <MenuItem Header="Properties" Command="{Binding TriggerPropertiesCommand}" IsVisible="{Binding IsFolderSelected}"/>

          <!-- ==================== 4. EMPTY FOLDER SPACE ==================== -->
          <MenuItem Header="Paste" Command="{Binding PasteFilesCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="New Folder" Command="{Binding TriggerNewFolderCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="New File" Command="{Binding TriggerNewFileCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="Open PowerShell Here" Command="{Binding OpenTerminalCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="🛡️ Open PowerShell as Administrator" Command="{Binding OpenTerminalAdminCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="Open Command Prompt (CMD) Here" Command="{Binding OpenCmdCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="🛡️ Open Command Prompt as Administrator" Command="{Binding OpenCmdAdminCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <Separator Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="Copy Current Path" Command="{Binding CopyCurrentPathCommand}" IsVisible="{Binding !IsItemSelected}"/>
          <MenuItem Header="Properties" Command="{Binding TriggerPropertiesCommand}" IsVisible="{Binding !IsItemSelected}"/>

          <!-- ==================== 5. COLUMNS & LAYOUT SUBMENU ==================== -->
          <Separator Background="{DynamicResource AppBorderBrush}"/>
          <MenuItem Header="⚙️ Columns &amp; Sizing">
            <MenuItem Header="⚡ Smart Auto-Fit Columns" Command="{Binding ToggleSmartSizingCommand}">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding SmartColumnSizing}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="🔄 Reset Column Layout &amp; Widths" Command="{Binding ResetColumnWidthsCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="Ext (.ext badge)" Command="{Binding ToggleColumnCommand}" CommandParameter="ext">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnExt}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Size" Command="{Binding ToggleColumnCommand}" CommandParameter="size">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnSize}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Date Modified" Command="{Binding ToggleColumnCommand}" CommandParameter="modified">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnDateModified}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Date Created" Command="{Binding ToggleColumnCommand}" CommandParameter="created">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnDateCreated}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Date Accessed" Command="{Binding ToggleColumnCommand}" CommandParameter="accessed">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnDateAccessed}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Item Type" Command="{Binding ToggleColumnCommand}" CommandParameter="type">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnItemType}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Attributes" Command="{Binding ToggleColumnCommand}" CommandParameter="attr">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnAttributes}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Permissions (Linux/POSIX)" Command="{Binding ToggleColumnCommand}" CommandParameter="perm">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnPermissions}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Owner:Group (Linux/POSIX)" Command="{Binding ToggleColumnCommand}" CommandParameter="owner">
              <MenuItem.Icon>
                <TextBlock Text="✓" IsVisible="{Binding ShowColumnOwnerGroup}" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"/>
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>

        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Columns>
        <!-- Name Column (Segoe UI Variable, Semibold folders, Regular files) -->
        <DataGridTemplateColumn Header="Name" Width="{Binding NameColumnWidthDisplay}" MinWidth="160" SortMemberPath="Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:FileItem">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="6,0" Opacity="{Binding RowOpacity}">
                <!-- Folder Icon: Slightly larger vector icon (16x13px) -->
                <Border IsVisible="{Binding IsDirectory}" Width="20" Height="20" VerticalAlignment="Center">
                  <Path Data="M 2 4 C 2 2.9 2.9 2 4 2 L 7.5 2 C 8.3 2 9.1 2.5 9.5 3.2 L 10.5 4.8 C 10.8 5.2 11.2 5.5 11.7 5.5 L 18 5.5 C 19.1 5.5 20 6.4 20 7.5 L 20 15 C 20 16.1 19.1 17 18 17 L 4 17 C 2.9 17 2 16.1 2 15 Z"
                        Fill="{DynamicResource AppAccentBrush}" Stroke="{DynamicResource AppHighlightBrush}" StrokeThickness="0.8" Width="16" Height="13" Stretch="Uniform"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- File Icon: Standard 12px file icon -->
                <Border IsVisible="{Binding !IsDirectory}" Width="20" Height="20" VerticalAlignment="Center">
                  <TextBlock Text="📄" FontSize="12" Foreground="{DynamicResource AppSubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Folder Name: Segoe UI Variable, Semibold, 13px -->
                <TextBlock Text="{Binding Name}" IsVisible="{Binding IsDirectory}"
                           FontFamily="{DynamicResource AppUiFont}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

                <!-- File Name: Segoe UI Variable, Regular Weight, 12.5px -->
                <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsDirectory}"
                           FontFamily="{DynamicResource AppUiFont}" FontWeight="Normal" FontSize="12.5" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Extension Tag Column (Clear tag pill, centered, comfortably sized) -->
        <DataGridTemplateColumn Header="Ext" Width="{Binding ExtColumnWidthDisplay}" MinWidth="55" SortMemberPath="Extension"
                                IsVisible="{Binding ShowColumnExt}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:FileItem">
              <Panel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding RowOpacity}">
                <Border Classes="badge-ext" IsVisible="{Binding HasExtensionBadge}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,1">
                  <TextBlock Text="{Binding ExtensionDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppHighlightBrush}"
                             FontFamily="{DynamicResource AppMonoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="—" IsVisible="{Binding !HasExtensionBadge}" FontSize="11.5" Foreground="{DynamicResource AppSubTextBrush}" Opacity="0.35"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource AppMonoFont}"/>
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Size Column (Cascadia Mono, Byte Size Sort) -->
        <DataGridTextColumn Header="Size" Width="{Binding SizeColumnWidthDisplay}" MinWidth="65"
                            Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes"
                            IsVisible="{Binding ShowColumnSize}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11.5"/>

        <!-- Date Modified Column (Cascadia Mono, Chronological Sort) -->
        <DataGridTextColumn Header="Date Modified" Width="{Binding ModifiedColumnWidthDisplay}" MinWidth="130"
                            Binding="{Binding FormattedModifiedTime}" SortMemberPath="ModifiedTime"
                            IsVisible="{Binding ShowColumnDateModified}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11.5"/>

        <!-- Date Created Column (Cascadia Mono, Chronological Sort) -->
        <DataGridTextColumn Header="Date Created" Width="{Binding CreatedColumnWidthDisplay}" MinWidth="130"
                            Binding="{Binding FormattedCreatedTime}" SortMemberPath="CreatedTime"
                            IsVisible="{Binding ShowColumnDateCreated}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11.5"/>

        <!-- Date Accessed Column (Cascadia Mono, Chronological Sort) -->
        <DataGridTextColumn Header="Date Accessed" Width="{Binding AccessedColumnWidthDisplay}" MinWidth="130"
                            Binding="{Binding FormattedAccessedTime}" SortMemberPath="AccessedTime"
                            IsVisible="{Binding ShowColumnDateAccessed}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11.5"/>

        <!-- Item Type Column (Segoe UI Variable) -->
        <DataGridTextColumn Header="Type" Width="{Binding TypeColumnWidthDisplay}" MinWidth="80" Binding="{Binding ItemTypeDisplay}"
                            IsVisible="{Binding ShowColumnItemType}"
                            FontFamily="{DynamicResource AppUiFont}" FontSize="11.5"/>

        <!-- Attributes Column (Cascadia Mono) -->
        <DataGridTextColumn Header="Attributes" Width="{Binding AttributesColumnWidthDisplay}" MinWidth="65" Binding="{Binding AttributesString}"
                            IsVisible="{Binding ShowColumnAttributes}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11.5"/>

        <!-- Permissions (Linux / POSIX) Column (Cascadia Mono) -->
        <DataGridTextColumn Header="Permissions" Width="{Binding PermissionsColumnWidthDisplay}" MinWidth="85" Binding="{Binding PermissionsString}"
                            IsVisible="{Binding ShowColumnPermissions}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11"/>

        <!-- Owner / Group (Linux / POSIX) Column (Cascadia Mono) -->
        <DataGridTextColumn Header="Owner:Group" Width="{Binding OwnerGroupColumnWidthDisplay}" MinWidth="85" Binding="{Binding OwnerGroupString}"
                            IsVisible="{Binding ShowColumnOwnerGroup}"
                            FontFamily="{DynamicResource AppMonoFont}" FontSize="11"/>
      </DataGrid.Columns>
    </DataGrid>

      <!-- 14px Dedicated Right Folder Background Gutter -->
      <Border Grid.Column="2" Background="{DynamicResource AppBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0"
              PointerPressed="OnFolderBackgroundStripPointerPressed"
              ToolTip.Tip="Folder Background Margin (Right-click for Folder Actions)">
        <Border.ContextMenu>
          <ContextMenu Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}"
                       BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <MenuItem Header="📁 New Folder" Command="{Binding TriggerNewFolderCommand}"/>
            <MenuItem Header="📄 New Text File" Command="{Binding TriggerNewFileCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="📋 Paste" Command="{Binding PasteFilesCommand}" IsEnabled="{Binding CanPaste}"/>
            <MenuItem Header=">_ Open PowerShell Here" Command="{Binding OpenTerminalCommand}"/>
            <MenuItem Header="🛡️ Open PowerShell as Administrator" Command="{Binding OpenTerminalAdminCommand}"/>
            <MenuItem Header="Open Command Prompt (CMD) Here" Command="{Binding OpenCmdCommand}"/>
            <MenuItem Header="🛡️ Open Command Prompt as Administrator" Command="{Binding OpenCmdAdminCommand}"/>
            <MenuItem Header="Open in VS Code" Command="{Binding OpenVSCodeCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="⟳ Refresh" Command="{Binding RefreshCommand}"/>
            <MenuItem Header="📋 Copy Current Path" Command="{Binding CopyCurrentPathCommand}"/>
            <Separator Background="{DynamicResource AppBorderBrush}"/>
            <MenuItem Header="ℹ️ Folder Properties" Command="{Binding TriggerPropertiesCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <Border.Styles>
          <Style Selector="Border:hover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
          </Style>
        </Border.Styles>
      </Border>

      <!-- Marquee Selection Canvas Overlay -->
      <Canvas x:Name="MarqueeCanvas" Grid.ColumnSpan="3" IsHitTestVisible="False" ZIndex="100">
        <Border x:Name="MarqueeBox" Background="#2638bdf8" BorderBrush="{DynamicResource AppHighlightBrush}"
                BorderThickness="1" CornerRadius="2" IsVisible="False"/>
      </Canvas>
    </Grid>

    <!-- Row 3: Bottom Live Filter Bar (Ctrl+F) -->
    <Border Grid.Row="3" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="⚡ Quick Filter:" Foreground="{DynamicResource AppHighlightBrush}" FontWeight="Bold"
                   FontFamily="{DynamicResource AppMonoFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

        <TextBox Grid.Column="1" Text="{Binding SelectedTab.FilterText, Mode=TwoWay}"
                 Watermark="Filter files (e.g. *.cs, test, build)..."
                 Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                 FontFamily="{DynamicResource AppMonoFont}" FontSize="11" Padding="6,2" Margin="0,0,8,0"/>

        <ToggleButton Grid.Column="2" IsChecked="{Binding SelectedTab.IsFilterRegex, Mode=TwoWay}"
                      Classes="power-btn" Content=".* Regex" FontSize="10" FontFamily="{DynamicResource AppMonoFont}"
                      Padding="6,2" Margin="0,0,4,0"/>

        <ToggleButton Grid.Column="3" IsChecked="{Binding SelectedTab.IsFilterWildcard, Mode=TwoWay}"
                      Classes="power-btn" Content="* Wildcard" FontSize="10" FontFamily="{DynamicResource AppMonoFont}"
                      Padding="6,2" Margin="0,0,8,0"/>

        <TextBlock Grid.Column="4" Text="{Binding SelectedTab.FilteredItems.Count, StringFormat='{}{0} items'}"
                   Foreground="{DynamicResource AppSubTextBrush}" FontSize="11" FontFamily="{DynamicResource AppMonoFont}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
