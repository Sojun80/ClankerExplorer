<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClankerExplorer.ViewModels"
        xmlns:models="clr-namespace:ClankerExplorer.Models"
        x:Class="ClankerExplorer.Views.BatchRenameWindow"
        x:DataType="vm:BatchRenameViewModel"
        Title="Power Batch Renamer - ClankerExplorer"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B101C" Foreground="#F8FAFC"
        CanResize="True">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
    <!-- Header -->
    <TextBlock Grid.Row="0" Text="⚡ Power Batch Renamer" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

    <!-- Rules Configuration Grid -->
    <Border Grid.Row="1" Background="#0F1626" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <!-- Inputs based on mode -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
            <TextBlock Text="Find Text / Prefix:" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas,monospace"/>
            <TextBox Text="{Binding FindText, Mode=TwoWay}" Background="#090D16" Foreground="#F8FAFC" BorderBrush="#1E293B" FontSize="11" FontFamily="Consolas,monospace"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Replace With / Suffix:" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas,monospace"/>
            <TextBox Text="{Binding ReplaceText, Mode=TwoWay}" Background="#090D16" Foreground="#F8FAFC" BorderBrush="#1E293B" FontSize="11" FontFamily="Consolas,monospace"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
            <CheckBox Content="Regular Expression" IsChecked="{Binding IsRegex, Mode=TwoWay}" FontSize="11"/>
            <CheckBox Content="Case Sensitive" IsChecked="{Binding CaseSensitive, Mode=TwoWay}" FontSize="11"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Live Before / After Diff Table -->
    <DataGrid Grid.Row="2" ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" IsReadOnly="True"
              Background="#090D16" BorderBrush="#1E293B" FontSize="11" FontFamily="Consolas,monospace">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Original Name" Binding="{Binding OriginalName}" Width="1.5*" Foreground="#94A3B8"/>
        <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="1.5*" Foreground="#38BDF8"/>
        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Footer Actions -->
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding ChangedCount, StringFormat='{}{0} items will change'}"
                 Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancelClicked" Classes="power-btn"/>
        <Button Content="Apply Rename" Command="{Binding ExecuteCommand}"
                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,4"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
