<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClankerExplorer.Views.ConfirmDeleteWindow"
        Title="Confirm Delete"
        Icon="/Assets/app-icon.png"
        Width="460" Height="210"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{DynamicResource AppUiFont}"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaChromeHints="Default">

  <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppBgBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- Title Bar -->
      <Border Grid.Row="0" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
              Height="32" Padding="12,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="TxtIcon" Text="🗑️" FontSize="11"/>
          <TextBlock x:Name="TxtTitle" Text="Move to Recycle Bin" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
        </StackPanel>
      </Border>

      <!-- Message Area -->
      <StackPanel Grid.Row="1" Spacing="8" Margin="16,14,16,10" VerticalAlignment="Center">
        <TextBlock x:Name="TxtHeader" Text="Are you sure you want to move this item to the Recycle Bin?"
                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtItemName"
                   FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppHighlightBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtItemPath"
                   FontSize="9.5" Foreground="{DynamicResource AppSubTextBrush}" FontFamily="{DynamicResource AppMonoFont}" TextWrapping="Wrap" MaxLines="2"/>
        <TextBlock x:Name="TxtWarning"
                   Text="⚠️ This action will permanently delete the item and bypass the Recycle Bin."
                   FontSize="10" FontWeight="Bold" Foreground="#EF4444" IsVisible="False"/>
      </StackPanel>

      <!-- Footer Buttons -->
      <Border Grid.Row="2" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Click="OnCancelClicked" Classes="power-btn"/>
          <Button x:Name="BtnDelete" Content="Move to Recycle Bin" Click="OnDeleteClicked"
                  Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,4"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
