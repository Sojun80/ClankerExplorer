<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClankerExplorer.ViewModels"
             xmlns:models="clr-namespace:ClankerExplorer.Models"
             xmlns:behaviors="clr-namespace:ClankerExplorer.Behaviors"
             x:Class="ClankerExplorer.Views.SearchWorkspaceView"
             x:DataType="vm:SearchWorkspaceViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             Background="{DynamicResource AppBgBrush}"
             FontFamily="{DynamicResource AppUiFont}">

  <UserControl.Styles>
    <Style Selector="Button.op-btn">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.op-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.op-btn-action">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.op-btn-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHighlightBrush}"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>
    <Style Selector="Button.op-btn-cancel">
      <Setter Property="Background" Value="#DC2626"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.op-btn-cancel:pointerover">
      <Setter Property="Background" Value="#EF4444"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppBgBrush}">
    <!-- 1. Workspace Header Bar -->
    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Title & Folder Context Badge -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="🔍" FontSize="16" Foreground="{DynamicResource AppHighlightBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="SEARCH" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" FontFamily="{DynamicResource AppMonoFont}" VerticalAlignment="Center"/>

          <!-- Active search indicator badge -->
          <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                  IsVisible="{Binding IsSearching}">
            <TextBlock Text="Searching..." FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{DynamicResource AppMonoFont}"/>
          </Border>

          <!-- Current Folder Context Indicator -->
          <Border Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="📁 Context:" FontSize="10.5" Foreground="{DynamicResource AppSubTextBrush}"/>
              <TextBlock Text="{Binding CurrentFolderPath}" FontSize="10.5" Foreground="{DynamicResource AppHighlightBrush}" FontFamily="{DynamicResource AppMonoFont}" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Right action: Close Workspace -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding CloseWorkspaceCommand}" Classes="op-btn-action" ToolTip.Tip="Close Search workspace and return to explorer [Esc]">
            <TextBlock Text="✕ Close Workspace"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. Search Control Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <StackPanel Spacing="8">
        <!-- Top Toolbar Row: Search Input + Clear Button + Scope Selector + Cancel/Stop Button -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <!-- Search Query TextBox with clear button -->
          <Grid Grid.Column="0" Margin="0,0,10,0">
            <TextBox x:Name="SearchTextBox"
                     Text="{Binding Query, Mode=TwoWay}"
                     Watermark="Type to search files and folders (e.g. filename, .ext, folder\file)..."
                     FontSize="13"
                     Padding="8,6,30,6"
                     Background="{DynamicResource AppBgBrush}"
                     Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     KeyDown="OnSearchTextBoxKeyDown"/>

            <!-- Inline Clear Button (visible when query not empty) -->
            <Button Command="{Binding ClearQueryCommand}"
                    IsVisible="{Binding Query.Length}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Padding="4,2"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource AppSubTextBrush}"
                    ToolTip.Tip="Clear query [Esc]">
              <TextBlock Text="✕" FontSize="11"/>
            </Button>
          </Grid>

          <!-- Scope Selector ComboBox -->
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding ScopeOptions}"
                    SelectedItem="{Binding SelectedScopeOption, Mode=TwoWay}"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AppBgBrush}"
                    Foreground="{DynamicResource AppTextBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:SearchScopeOption">
                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Cancel Search Button -->
          <Button Grid.Column="2"
                  Command="{Binding CancelSearchCommand}"
                  IsVisible="{Binding IsSearching}"
                  Classes="op-btn-cancel"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Cancel active search">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="⏹" FontSize="10" VerticalAlignment="Center"/>
              <TextBlock Text="Stop" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Status & Results Counter Bar -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding StatusText}"
                     FontSize="11.5"
                     Foreground="{DynamicResource AppSubTextBrush}"
                     FontFamily="{DynamicResource AppMonoFont}"
                     VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalResultCount, StringFormat='{}{0:N0} items'}"
                       FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppHighlightBrush}"
                       FontFamily="{DynamicResource AppMonoFont}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 3. Results DataGrid -->
    <DataGrid x:Name="ResultsDataGrid"
              Grid.Row="2"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              SelectionMode="Single"
              GridLinesVisibility="None"
              DoubleTapped="OnRowDoubleTapped"
              KeyDown="OnResultsDataGridKeyDown"
              Background="{DynamicResource AppBgBrush}"
              BorderThickness="0"
              FontFamily="{DynamicResource AppUiFont}">

      <!-- Right-Click Context Menu -->
      <DataGrid.ContextMenu>
        <ContextMenu Background="{DynamicResource AppSurfaceBrush}"
                     Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     BorderThickness="1">
          <MenuItem Header="Open" Command="{Binding OpenItemCommand}" InputGesture="Enter"/>
          <MenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" InputGesture="Ctrl+Enter"/>
          <Separator Background="{DynamicResource AppBorderBrush}"/>
          <MenuItem Header="Copy Full Path" Command="{Binding CopyPathCommand}" InputGesture="Ctrl+C"/>
          <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Columns>
        <!-- Name Column with Icon -->
        <DataGridTemplateColumn Header="Name" Width="280" MinWidth="140" SortMemberPath="Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:SearchResultItem">
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="6,0">
                <!-- Icon container -->
                <Panel Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                  <!-- Native High-Res Windows Icon -->
                  <Image Source="{Binding FileIcon}" IsVisible="{Binding HasFileIcon}" Width="16" Height="16" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

                  <!-- Fallback Vector Folder -->
                  <Border Width="20" Height="20" VerticalAlignment="Center">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsDirectory"/>
                        <Binding Path="!HasFileIcon"/>
                      </MultiBinding>
                    </Border.IsVisible>
                    <Path Data="M 2 4 C 2 2.9 2.9 2 4 2 L 7.5 2 C 8.3 2 9.1 2.5 9.5 3.2 L 10.5 4.8 C 10.8 5.2 11.2 5.5 11.7 5.5 L 18 5.5 C 19.1 5.5 20 6.4 20 7.5 L 20 15 C 20 16.1 19.1 17 18 17 L 4 17 C 2.9 17 2 16.1 2 15 Z"
                          Fill="{DynamicResource AppAccentBrush}" Stroke="{DynamicResource AppHighlightBrush}" StrokeThickness="0.8" Width="16" Height="13" Stretch="Uniform"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>

                  <!-- Fallback Generic File -->
                  <TextBlock Text="📄" FontSize="12" Foreground="{DynamicResource AppSubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsDirectory"/>
                        <Binding Path="!HasFileIcon"/>
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                </Panel>

                <!-- Name TextBlock -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           behaviors:AutoToolTip.ShowWhenTrimmed="True"
                           FontFamily="{DynamicResource AppUiFont}"
                           FontSize="12.5"
                           Foreground="{DynamicResource AppTextBrush}"
                           VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Path Column -->
        <DataGridTemplateColumn Header="Path" Width="*" MinWidth="180" SortMemberPath="ParentPath">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:SearchResultItem">
              <TextBlock Text="{Binding ParentPath}"
                         TextTrimming="CharacterEllipsis"
                         behaviors:AutoToolTip.ShowWhenTrimmed="True"
                         FontSize="11.5"
                         Foreground="{DynamicResource AppSubTextBrush}"
                         FontFamily="{DynamicResource AppMonoFont}"
                         VerticalAlignment="Center"
                         Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Size Column -->
        <DataGridTemplateColumn Header="Size" Width="100" MinWidth="70" SortMemberPath="SizeBytes">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:SearchResultItem">
              <TextBlock Text="{Binding FormattedSize}"
                         TextAlignment="Right"
                         FontSize="11.5"
                         Foreground="{DynamicResource AppTextBrush}"
                         FontFamily="{DynamicResource AppMonoFont}"
                         VerticalAlignment="Center"
                         Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Modified Column -->
        <DataGridTemplateColumn Header="Modified" Width="140" MinWidth="100" SortMemberPath="ModifiedTime">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:SearchResultItem">
              <TextBlock Text="{Binding FormattedModifiedTime}"
                         FontSize="11"
                         Foreground="{DynamicResource AppSubTextBrush}"
                         FontFamily="{DynamicResource AppMonoFont}"
                         VerticalAlignment="Center"
                         Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Type Column -->
        <DataGridTemplateColumn Header="Type" Width="120" MinWidth="80" SortMemberPath="Extension">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="models:SearchResultItem">
              <TextBlock Text="{Binding ItemTypeDisplay}"
                         TextTrimming="CharacterEllipsis"
                         behaviors:AutoToolTip.ShowWhenTrimmed="True"
                         FontSize="11"
                         Foreground="{DynamicResource AppSubTextBrush}"
                         VerticalAlignment="Center"
                         Margin="6,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
