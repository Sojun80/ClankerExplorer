<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClankerExplorer.Views.VideoThumbnailTimeWindow"
        Title="Choose Thumbnail Timestamp - ClankerExplorer"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        Background="#0B101C" Foreground="#F8FAFC"
        CanResize="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <!-- Title -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="⏱️ New Thumbnail at Time" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8"/>
      <TextBlock x:Name="TxtFileName" Text="video.mp4" FontSize="11" Foreground="#94A3B8"
                 TextTrimming="CharacterEllipsis"/>
    </StackPanel>

    <!-- Main Content Area -->
    <StackPanel Grid.Row="1" Spacing="10">
      <DockPanel LastChildFill="True">
        <TextBlock Text="Timestamp (mm:ss or hh:mm:ss):" FontSize="11" Foreground="#CBD5E1"
                   FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtDuration" Text="Duration: --:--" FontSize="10.5" Foreground="#38BDF8"
                   FontFamily="Consolas,monospace" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Time Input Box -->
      <TextBox x:Name="TxtTimeInput" Background="#090D16" Foreground="#F8FAFC" BorderBrush="#1E293B"
               FontSize="13" FontFamily="Consolas,monospace" Padding="8,5"
               Watermark="e.g. 01:45 or 45" KeyDown="OnTimeInputKeyDown"/>

      <!-- Quick Depth Preset Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="Quick Jump:" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,2,0"/>
        <Button Content="10%" Click="OnPresetClicked" Tag="0.10" Classes="power-btn" Padding="6,2" FontSize="10"/>
        <Button Content="25%" Click="OnPresetClicked" Tag="0.25" Classes="power-btn" Padding="6,2" FontSize="10"/>
        <Button Content="50%" Click="OnPresetClicked" Tag="0.50" Classes="power-btn" Padding="6,2" FontSize="10"/>
        <Button Content="75%" Click="OnPresetClicked" Tag="0.75" Classes="power-btn" Padding="6,2" FontSize="10"/>
        <Button Content="90%" Click="OnPresetClicked" Tag="0.90" Classes="power-btn" Padding="6,2" FontSize="10"/>
      </StackPanel>

      <!-- Error Text -->
      <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="10.5" IsVisible="False" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Footer Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancelClicked" Classes="power-btn" Padding="12,4"/>
      <Button Content="Generate Thumbnail" Click="OnGenerateClicked"
              Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,4"/>
    </StackPanel>
  </Grid>
</Window>
