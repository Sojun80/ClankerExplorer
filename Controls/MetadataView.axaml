<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:meta="clr-namespace:ClankerExplorer.Services.Metadata"
             xmlns:controls="clr-namespace:ClankerExplorer.Controls"
             x:Class="ClankerExplorer.Controls.MetadataView"
             x:DataType="controls:MetadataView"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="600">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="SectionsList" ItemsSource="{Binding Sections, RelativeSource={RelativeSource AncestorType=controls:MetadataView}}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="meta:MetadataSection" x:DataType="meta:MetadataSection">
          <Border Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10,8"
                  Margin="0,0,0,8">
            <StackPanel Spacing="6">
              <!-- Section Header -->
              <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AppHighlightBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>

              <!-- Items in Section -->
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="meta:MetadataItem" x:DataType="meta:MetadataItem">
                    <Grid ColumnDefinitions="110,*,Auto" Margin="0,2">
                      <!-- Field Label -->
                      <TextBlock Grid.Column="0" Text="{Binding Key}"
                                 Foreground="{DynamicResource AppSubTextBrush}"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 TextTrimming="CharacterEllipsis"/>

                      <!-- Field Value (Selectable & Copyable) -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBox Text="{Binding Value}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="11"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 VerticalAlignment="Center"
                                 SelectionBrush="{DynamicResource AppAccentBrush}">
                          <TextBox.Styles>
                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                              <Setter Property="Background" Value="Transparent"/>
                              <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                          </TextBox.Styles>
                        </TextBox>

                        <!-- Secondary muted hint (e.g. smart time "Just now") -->
                        <TextBlock Text="{Binding SecondaryValue}"
                                   IsVisible="{Binding SecondaryValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource AppSubTextBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                      </StackPanel>

                      <!-- Badge if present -->
                      <Border Grid.Column="2"
                              IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Background="{DynamicResource AppBgBrush}"
                              BorderBrush="{DynamicResource AppBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="3"
                              Padding="5,1"
                              Margin="4,0,0,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppHighlightBrush}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
