<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClankerExplorer.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Default Dynamic Theme Resources (Live Modifiable by ThemeManager) -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#080C14"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0F1626"/>
    <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AppHighlightBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppSubTextBrush" Color="#94A3B8"/>
    
    <!-- Windows Native High Legibility Typography -->
    <FontFamily x:Key="AppUiFont">Segoe UI Variable, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="AppMonoFont">Cascadia Mono, Cascadia Code, Consolas, JetBrains Mono, monospace</FontFamily>

    <!-- Global ScrollBar Resources (Force Thick Dimensions & No Hairline Slim) -->
    <x:Double x:Key="ScrollBarSize">14</x:Double>
    <x:Double x:Key="ScrollBarThumbThickness">10</x:Double>
    <x:Double x:Key="ScrollBarButtonSize">14</x:Double>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

    <!-- Custom Power User Dynamic Dark Styling -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
    </Style>

    <!-- Always Thick Scrollbars (Never allow slim / auto-hide collapsing hairline) -->
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="ScrollBar">
      <Setter Property="AllowAutoHide" Value="False"/>
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
    </Style>

    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
    </Style>

    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="14"/>
      <Setter Property="MinHeight" Value="14"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Thumb">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ Thumb">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource AppHighlightBrush}"/>
    </Style>

    <!-- DataGrid Dynamic Theme with Comfortable Row Spacing -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource AppBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="RowBackground" Value="{DynamicResource AppBgBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppSubTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="8,6,6,6"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
    </Style>

    <Style Selector="DataGridRow">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="32"/>
    </Style>

    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource AppSurfaceHoverBrush}"/>
    </Style>

    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- Power Buttons -->
    <Style Selector="Button.power-btn">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppHighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
    </Style>
    <Style Selector="Button.power-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Toggle Buttons -->
    <Style Selector="ToggleButton.power-btn">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppSubTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppUiFont}"/>
    </Style>
    <Style Selector="ToggleButton.power-btn:checked">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Extension Tag Badges (Clear, Legible, Comfortable Tag Layout) -->
    <Style Selector="Border.badge-ext">
      <Setter Property="Background" Value="#121D30"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppHighlightBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- File Size Logarithmic Progress Bar (Zero-allocation, No Animation / Virtualization Optimized) -->
    <Style Selector="ProgressBar.size-bar">
      <Setter Property="Height" Value="18"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Transitions" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </Application.Styles>
</Application>
