<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.53</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyTitle>C-Explorer</AssemblyTitle>
    <Product>C-Explorer</Product>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <Target Name="GenerateBuildMetadata" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <BuildDateUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'"))</BuildDateUtc>
      <BuildDateShort>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuildDateShort>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <ResolvedBuildNumber Condition="'$(GitCommitCount)' != ''">$([System.String]::Copy('$(GitCommitCount)').Trim())</ResolvedBuildNumber>
      <ResolvedBuildNumber Condition="'$(ResolvedBuildNumber)' == ''">1</ResolvedBuildNumber>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLine Include="// &lt;auto-generated /&gt;" />
      <_BuildInfoLine Include="namespace ClankerExplorer%3B" />
      <_BuildInfoLine Include="public static class BuildInfo" />
      <_BuildInfoLine Include="{" />
      <_BuildInfoLine Include="    public const string BuildNumber = &quot;$(ResolvedBuildNumber)&quot;%3B" />
      <_BuildInfoLine Include="    public const string BuildTimestamp = &quot;$(BuildDateUtc)&quot;%3B" />
      <_BuildInfoLine Include="    public const string ShortDateTime = &quot;$(BuildDateShort)&quot;%3B" />
      <_BuildInfoLine Include="    public const string DisplayString = &quot;Build $(ResolvedBuildNumber) • $(BuildDateShort)&quot;%3B" />
      <_BuildInfoLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Explicit patched version to resolve security advisory GHSA-xrw6-gwf8-vvr9 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- LibVLC Video Engine Direct DLL References (AnyCPU .NET 8) -->
    <Reference Include="LibVLCSharp">
      <HintPath>lib\LibVLCSharp.dll</HintPath>
    </Reference>
    <Reference Include="LibVLCSharp.Avalonia">
      <HintPath>lib\LibVLCSharp.Avalonia.dll</HintPath>
    </Reference>
    <None Include="libvlc\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="SyncNet8LegacyOutput" AfterTargets="Build" Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">
    <ItemGroup>
      <OutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputFiles)" DestinationFiles="@(OutputFiles->'$(SolutionDir)bin\$(Configuration)\net8.0\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" Retries="0" />
  </Target>
</Project>
